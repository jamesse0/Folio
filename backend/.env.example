# Database
DATABASE_URL=postgresql://user:password@localhost:5432/folio

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=your-secret-here
JWT_EXPIRE_DAYS=7

# File storage
UPLOAD_DIR=/absolute/path/to/folio/uploads/originals
THUMBNAIL_DIR=/absolute/path/to/folio/uploads/thumbnails
MAX_UPLOAD_MB=25

# ML thresholds (used in Phase 2)
FACE_CLUSTER_MIN_SIZE=3
FACE_SIMILARITY_THRESHOLD=0.6
VIBE_DEGRADATION_THRESHOLD=5
